# 복사해서 .env.local 로 저장한 뒤 값 채우기 (Vercel에도 같은 이름으로 등록)
# Supabase 대시보드 → Project Settings → API (API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon 키(eyJ...) 또는 publishable 키(sb_publishable_...) — 이름은 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 로 등록해도 됨
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 실제 서비스 주소 (canonical·OG·sitemap 에 사용). 도메인을 연결하면 그 주소로 바꾸세요
NEXT_PUBLIC_SITE_URL=https://minigame-on.vercel.app
